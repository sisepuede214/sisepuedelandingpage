# PostHog (public browser config)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Klaviyo (server-side only)
KLAVIYO_API_KEY=pk_your_private_api_key
KLAVIYO_LIST_ID=your_list_id
KLAVIYO_LIST_ID_POSTEVENT=your_postevent_list_id
KLAVIYO_LIST_ID_PHOTOS=Snqf86
KLAVIYO_LIST_ID_LA_BANDERA_HTX=VD2DeL

# Shopify Admin API (server-side only — founders pre-order counter)
# Custom app scope required: read_orders (email-based dedupe; read_customers not needed)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_api_token
# Optional: comma-separated owner/internal emails to exclude from the count
# FOUNDERS_EXCLUDED_EMAILS=owner1@example.com,owner2@example.com
# FOUNDERS_EXCLUDED_NAMES=Daniel Flores
